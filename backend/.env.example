# Copy to .env and fill in values. Never commit .env.

# Port for local development (Render sets PORT automatically)
PORT=4000

# Supabase project URL (Project Settings → API)
# No trailing path — not .../rest/v1/
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon (public) key — safe on server; used to verify JWTs and run user-scoped queries
SUPABASE_ANON_KEY=your_anon_key_here

# Allowed browser origin(s) for CORS + Socket.IO (comma-separated, no trailing slash).
# Production: your Vercel URL(s) exactly as in the address bar, e.g. https://pinokio.vercel.app
# If you use Preview deployments or the URL keeps changing, set FRONTEND_ALLOW_VERCEL=true (see below).
FRONTEND_URL=http://localhost:5173

# Optional (Render): allow any https://*.vercel.app origin — fixes chat when FRONTEND_URL ≠ preview URL.
# FRONTEND_ALLOW_VERCEL=true
