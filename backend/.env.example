# Copy to .env and fill in values. Never commit .env.

# Port for local development (Render sets PORT automatically)
PORT=4000

# Supabase project URL (Project Settings → API)
# No trailing path — not .../rest/v1/
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon (public) key — safe on server; used to verify JWTs and run user-scoped queries
SUPABASE_ANON_KEY=your_anon_key_here

# Allowed browser origin(s) for CORS + Socket.IO (comma-separated).
# When NODE_ENV is not "production", localhost / 127.0.0.1 on any port is also allowed
# so Vite can use 5174 if 5173 is busy.
FRONTEND_URL=http://localhost:5173
