# Copy to .env.local for Vite (local dev). Never commit real keys.

# Supabase (Project Settings → API) — anon key only on the frontend
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Backend + Socket.IO. Use https:// on production (must match page — mixed content breaks chat).
# Local dev: omit to use Vite proxy, or set http://localhost:4000
# VITE_SOCKET_URL=https://your-api.onrender.com

# Optional: if WebSocket keeps failing, force long-polling only (set to 1 on Vercel and redeploy).
# VITE_SOCKET_FORCE_POLLING=1

# Optional: health checks / future REST calls
VITE_API_URL=http://localhost:4000
