# Copy to .env.local for Vite (local dev). Never commit real keys.

# Supabase (Project Settings → API) — anon key only on the frontend
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Backend + Socket.IO. In local dev you can omit this: Vite proxies /socket.io to :4000 (see vite.config.js).
# VITE_SOCKET_URL=http://localhost:4000

# Optional: health checks / future REST calls
VITE_API_URL=http://localhost:4000
